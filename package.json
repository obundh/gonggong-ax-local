{
  "name": "gonggong-ax-local-series-2-document-review",
  "version": "0.1.0",
  "license": "UNLICENSED",
  "private": true,
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/series3-analyzer.test.mjs tests/series3-local-ai.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "desktop:dir": "npm run build && electron-builder --dir",
    "desktop:build": "npm run build && node scripts/build-desktop.mjs",
    "media:threads": "node scripts/build-threads-comic.mjs"
  },
  "dependencies": {
    "@rhwp/core": "^0.8.0",
    "drizzle-orm": "0.45.2",
    "jszip": "^3.10.1",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.8",
    "sharp": "0.35.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "type": "module",
  "build": {
    "appId": "kr.local.publicax",
    "productName": "공공AX 로컬 시리즈 2 - 문서 검수",
    "asar": false,
    "compression": "store",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "dist/**/*",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "docs/LEGAL_REVIEW.md",
      "docs/USER_GUIDE.md",
      "!node_modules{,/**/*}"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "GonggongAX-Series2-Document-Review-${version}-win-x64.${ext}"
    }
  }
}
